# ── xAI (Grok) ─────────────────────────────────────────────
XAI_API_KEY=
# Modèle par défaut ; vérifie les noms disponibles sur console.x.ai
GROK_MODEL=grok-4
# Optionnel : un modèle moins cher pour certains bots
# GROK_MODEL_SCANNER=grok-4-fast
# GROK_MODEL_NEWS=grok-4-fast

# ── Telegram ──────────────────────────────────────────────
# ID du groupe (négatif, ex. -1001234567890)
TELEGRAM_CHAT_ID=
# Un bot par personnage (créés avec @BotFather) → six noms et avatars distincts
TELEGRAM_TOKEN_SCANNER=
TELEGRAM_TOKEN_NEWS=
TELEGRAM_TOKEN_PLANNER=
TELEGRAM_TOKEN_RISK=
TELEGRAM_TOKEN_SKEPTIC=
TELEGRAM_TOKEN_CHEF=
# …ou un seul bot pour tous (les messages sont préfixés par le nom du personnage)
TELEGRAM_TOKEN=
DESK_TYPING_DELAY_MS=2500

# ── Données ───────────────────────────────────────────────
# yahoo (gratuit, sans clé) ou tradingview (ton TradingView Desktop via CDP, port 9222)
DESK_SOURCE=yahoo
TV_TIMEFRAME=5
DESK_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,GOOGL,NFLX,PLTR,COIN,SMCI,AVGO,MU,SOFI
DESK_CYCLE_MINUTES=15

# ── Scanner ───────────────────────────────────────────────
SCAN_MIN_REL_VOLUME=2.0
SCAN_MIN_BAR_SPIKE=3.0
SCAN_MIN_PRICE=5
SCAN_MAX_CANDIDATES=3

# ── Risque (appliqué en code ET injecté dans les scripts Pine) ──
RISK_CAPITAL=25000
RISK_PER_TRADE_PCT=0.5
RISK_MIN_RR=1.5
RISK_MAX_STOP_PCT=3
RISK_MAX_ENTRY_DISTANCE_PCT=1.5
RISK_MAX_POSITION_PCT=25
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_TRADES_PER_DAY=5
RISK_DAILY_LOSS_LIMIT_PCT=2
RISK_NO_ENTRY_FIRST_MIN=15
RISK_NO_ENTRY_LAST_MIN=45
RISK_FLATTEN_MIN_BEFORE_CLOSE=5
RISK_PENDING_EXPIRY_MIN=45

# ── Paramètres propres aux scripts Pine ───────────────────
PINE_STOP_ATR=1.5
PINE_RR_TARGET=2
PINE_MAX_EXT_ATR=3
